{
  "name": "jihye",
  "version": "0.2.0",
  "private": true,
  "description": "Jihye, a personal collection of extensions and skills for the Pi coding agent",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "preview:pi-pet": "tsx scripts/preview-pi-pet.ts",
    "preview:pi-pet:watch": "tsx watch --clear-screen=false scripts/preview-pi-pet.ts --watch-mode",
    "test": "node scripts/test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.0",
    "shell-quote": "^1.8.3",
    "turndown": "^7.2.0",
    "unpdf": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "tsx": "^4.23.5"
  }
}
